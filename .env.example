# PostgreSQL application connection.
DATABASE_URL=postgresql+psycopg://eve:eve@localhost:5432/eve

# Local PostgreSQL provisioning values for Docker Compose, added in a later step.
POSTGRES_DB=eve
POSTGRES_USER=eve
POSTGRES_PASSWORD=replace-with-a-local-password

# Authentication settings. Replace all placeholder secrets before enabling auth routes.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=eve-diagnostic-booking-api
JWT_AUDIENCE=eve-api
JWT_EXPIRE_MINUTES=30

# Simulated payment webhook authentication.
MOCK_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Application behavior.
LOG_LEVEL=INFO

# Set to the Alembic head revision after applying migrations.
ALEMBIC_EXPECTED_REVISION=20261001_01

# Used only by the future explicit seed command.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
